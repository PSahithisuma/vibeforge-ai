# =============================================================================
# VibeForge — Environment Variables
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (system of record)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vibeforge
POSTGRES_PASSWORD=vibeforge_dev_secret
POSTGRES_DB=vibeforge

# Connection URL used by the API and worker (asyncpg)
DATABASE_URL=postgresql+asyncpg://vibeforge:vibeforge_dev_secret@postgres:5432/vibeforge

# Sync URL used by Alembic for migrations
DATABASE_URL_SYNC=postgresql://vibeforge:vibeforge_dev_secret@postgres:5432/vibeforge

# -----------------------------------------------------------------------------
# Redis (job broker, rate buckets, hot counters — never system of record)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret
REDIS_URL=redis://:redis_dev_secret@redis:6379/0

# -----------------------------------------------------------------------------
# Qdrant (vector store)
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Uncomment and set for production deployments with API key enabled:
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# MinIO (object storage: docs, bundles, build logs, SBOMs)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=vibeforge
MINIO_ROOT_PASSWORD=vibeforge_minio_secret
MINIO_USE_SSL=false

# Bucket names
MINIO_BUCKET_DOCS=vf-docs
MINIO_BUCKET_BUNDLES=vf-bundles
MINIO_BUCKET_LOGS=vf-build-logs

# -----------------------------------------------------------------------------
# Keycloak (OIDC provider)
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=vibeforge
KEYCLOAK_CLIENT_ID=vibeforge-api
KEYCLOAK_CLIENT_SECRET=vibeforge-api-secret-change-me

# JWKS URL (used by the API for token validation)
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/vibeforge/protocol/openid-connect/certs

# -----------------------------------------------------------------------------
# Langfuse (LLM observability — Phase 0: running, not yet wired)
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=lf-secret-key-dev
LANGFUSE_PUBLIC_KEY=lf-public-key-dev
LANGFUSE_HOST=http://langfuse:3000
# Internal Langfuse DB (separate schema in shared Postgres)
LANGFUSE_DATABASE_URL=postgresql://vibeforge:vibeforge_dev_secret@postgres:5432/langfuse
LANGFUSE_NEXTAUTH_SECRET=langfuse-nextauth-secret-dev
LANGFUSE_SALT=langfuse-salt-dev

# -----------------------------------------------------------------------------
# Prometheus & Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# API Service
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_ENV=development

# JWT settings (derived from Keycloak — do not set manually in prod)
JWT_ALGORITHM=RS256

# Tenant RLS setting name (must match 02_rls.sql)
TENANT_SETTING_KEY=app.current_tenant_id

# -----------------------------------------------------------------------------
# Worker Service
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_MAX_JOBS=10

# -----------------------------------------------------------------------------
# Seed data (local dev only)
# -----------------------------------------------------------------------------
SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
SEED_TENANT_SLUG=dev-tenant
